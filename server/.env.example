# Copy to .env and fill in. Never commit .env.

# Render injects PORT automatically; only needed locally.
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/workwave?retryWrites=true&w=majority

# Long random string used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-string

# Stripe secret key (Dashboard > Developers > API keys)
STRIPE_KEY=sk_test_xxx

# Frontend URL Stripe redirects back to after checkout
DOMAIN_URL=http://localhost:3000

# Allowed CORS origin(s), comma-separated, no trailing slash
CLIENT_URL=http://localhost:3000
