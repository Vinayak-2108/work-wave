# Copy to .env and fill in. CRA only exposes vars prefixed with REACT_APP_,
# and they are baked in at build time (redeploy after changing them).

# Backend base URL, no trailing slash
REACT_APP_API_URL=http://localhost:5000

# PayPal REST app client ID (public, but differs between sandbox and live)
REACT_APP_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
